{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "extractor", "prompt_version", "source_content_hash", "cost", "fields", "locators"],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "extractor": {"type": "string", "minLength": 1, "maxLength": 500},
    "prompt_version": {"type": "string", "minLength": 1, "maxLength": 500},
    "source_content_hash": {"type": "string", "maxLength": 128},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usd"],
      "properties": {"usd": {"type": "number", "minimum": 0}}
    },
    "fields": {"type": "object"},
    "locators": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 500}}
  }
}
