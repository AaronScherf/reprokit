{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_date_utc", "steps", "outputs"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_date_utc": {"type": "string", "format": "date-time"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "elapsed_seconds", "peak_rss_mb", "rss_basis", "measurement_run_date_utc", "skipped"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "elapsed_seconds": {"type": "number", "minimum": 0},
          "peak_rss_mb": {"type": "number", "minimum": 0},
          "rss_basis": {"enum": ["process", "tree"]},
          "measurement_run_date_utc": {"type": "string", "format": "date-time"},
          "skipped": {"type": "boolean"}
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
